{
  "uid": "nexora-backend",
  "title": "Nexora Backend",
  "tags": ["nexora", "backend"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend Up",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "up{job=\"backend\"}", "refId": "A" }],
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Backend Request Rate",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_total{job=\"backend\"}[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Backend Latency",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{job=\"backend\"}[5m])) by (le))",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Backend 5xx",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_total{job=\"backend\",status=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 }
    }
  ]
}
