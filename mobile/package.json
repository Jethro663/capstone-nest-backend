{
  "name": "nexora-lms-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Expo prototype for the Figma Make LMS mobile design",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:emulator": "set EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api&& expo start --android --port 8081",
    "expo:kill-8081": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$p=(Get-NetTCPConnection -LocalPort 8081 -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty OwningProcess); if($p){Stop-Process -Id $p -Force}\"",
    "android:emulator:clean": "npm run expo:kill-8081 && npm run android:emulator",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:release": "node --test scripts/app-version-release.test.cjs",
    "release:prepare": "node scripts/app-version-release.cjs prepare",
    "release:verify": "node scripts/app-version-release.cjs verify",
    "postinstall": "patch-package",
    "build:rich-text": "node scripts/build-assessment-rich-text.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.10",
    "@react-navigation/native-stack": "^6.9.19",
    "@tanstack/react-query": "^5.22.2",
    "@tiptap/core": "3.21.0",
    "@tiptap/extension-link": "3.21.0",
    "@tiptap/starter-kit": "3.21.0",
    "axios": "^1.18.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.0",
    "expo-linear-gradient": "~15.0.7",
    "expo-notifications": "~0.32.17",
    "expo-screen-capture": "~8.0.10",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.8",
    "expo-updates": "~29.0.20",
    "fs-extra": "^11.4.0",
    "jszip": "^3.10.1",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "4.1.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "esbuild": "^0.28.2",
    "jest": "~29.7.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@tiptap/core": "3.21.0",
    "@tiptap/pm": "3.21.0",
    "@tiptap/extension-link": "3.21.0",
    "@tiptap/starter-kit": "3.21.0",
    "@tiptap/extension-blockquote": "3.21.0",
    "@tiptap/extension-bold": "3.21.0",
    "@tiptap/extension-bullet-list": "3.21.0",
    "@tiptap/extension-code": "3.21.0",
    "@tiptap/extension-code-block": "3.21.0",
    "@tiptap/extension-document": "3.21.0",
    "@tiptap/extension-dropcursor": "3.21.0",
    "@tiptap/extension-gapcursor": "3.21.0",
