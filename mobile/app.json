{
  "expo": {
    "name": "Nexora Mobile",
    "slug": "nexora-lms-mobile",
    "version": "0.1.5",
    "orientation": "default",
    "scheme": "nexora-lms-mobile",
    "userInterfaceStyle": "light",
    "icon": "./assets/ja/apk_logo.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "2"
    },
    "android": {
      "package": "com.nexora.lms.mobile",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/ja/apk_logo.png",
        "backgroundColor": "#000000"
      },
      "versionCode": 6,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-document-picker",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20",
            "kspVersion": "2.1.20-2.0.1"
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0b0abab5-317d-4bfd-b6c9-fb291bd05a8c"
      }
    }
  }
}
