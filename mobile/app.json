{
  "expo": {
    "name": "Nexora Mobile",
    "slug": "nexora-lms-mobile",
    "version": "0.1.16",
    "orientation": "default",
    "scheme": "nexora-lms-mobile",
    "userInterfaceStyle": "light",
    "icon": "./assets/ja/apk_logo.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "3"
    },
    "android": {
      "package": "com.nexora.lms.mobile",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/ja/apk_logo.png",
        "backgroundColor": "#000000"
      },
      "versionCode": 17,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-document-picker",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20",
            "kspVersion": "2.1.20-2.0.1"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "440f3e6f-ae69-495d-b391-4f4eab9d465e"
      }
    },
    "owner": "jethro663",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/440f3e6f-ae69-495d-b391-4f4eab9d465e"
    }
  }
}
