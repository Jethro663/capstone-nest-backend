NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@HOST:5432/capstone
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

REDIS_URL=redis://HOST:6379

FRONTEND_URL=https://your-frontend.example.com
NEXT_FRONTEND_URL=https://your-frontend.example.com
MOBILE_URL=
BACKEND_PUBLIC_URL=https://your-backend.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
COOKIE_DOMAIN=
TRUST_PROXY_HOPS=1

JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OTP_PEPPER=CHANGE_ME_MIN_32_CHARS

# Leave blank for development. Set to gmail or resend only with valid credentials.
EMAIL_SERVICE=
EMAIL_USER=CHANGE_ME_EMAIL
EMAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
EMAIL_FROM=Nexora LMS <no-reply@example.com>

# Production/Railway: point this to the internal ai-service URL or Railway private domain,
# not a public browser-facing URL. `AI_SERVICE_SHARED_SECRET` must exactly match the
# ai-service value because backend forwards it as `X-Internal-Service-Token`.
# Keep `AI_DEGRADED_ALLOWED` aligned with ai-service so backend and ai-service agree
# on whether degraded AI runtime is acceptable.
# Phase 1 Azure deploy: keep AI in degraded mode and do not set OLLAMA_BASE_URL
# until Ollama is deployed. For OpenRouter-primary production, ai-service can stay
# healthy with `AI_RUNTIME_MODE=cloud` even while `OLLAMA_BASE_URL` is unset.
OLLAMA_BASE_URL=
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=gemma3:4b
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_CHAT_MS=70000
AI_SERVICE_TIMEOUT_EXTRACTION_MS=300000
AI_SERVICE_TIMEOUT_LESSON_PLAN_MS=300000
AI_SERVICE_TIMEOUT_INTERNAL_QUIZ_MS=180000
AI_SERVICE_TIMEOUT_INTERNAL_INTERVENTION_MS=180000
AI_SERVICE_SHARED_SECRET=CHANGE_ME_INTERNAL_SHARED_SECRET
AI_DEGRADED_ALLOWED=true

OTEL_EXPORTER_OTLP_ENDPOINT=
LOKI_HOST=
