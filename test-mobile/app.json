{
  "expo": {
    "name": "Nexora Mobile",
    "slug": "nexora-lms-test-mobile",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "nexora-lms-test-mobile",
    "userInterfaceStyle": "light",
    "icon": "./assets/ja/apk_logo.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "1"
    },
    "android": {
      "package": "com.nexora.lms.mobile",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/ja/apk_logo.png",
        "backgroundColor": "#000000"
      },
      "versionCode": 1
    },
    "plugins": [
      "expo-document-picker"
    ]
  }
}
