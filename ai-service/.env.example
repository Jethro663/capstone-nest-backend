DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/capstone
# Phase 1 Azure deploy: leave OLLAMA_BASE_URL unset and keep AI_DEGRADED_ALLOWED=true.
# Set this only after Ollama is deployed in Phase 2.
OLLAMA_BASE_URL=
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_CHAT_S=60
OLLAMA_TIMEOUT_EXTRACTION_S=240
OLLAMA_KEEP_ALIVE=15m
UPLOAD_DIR=/app/uploads
BACKEND_INTERNAL_URL=http://localhost:3000
MAX_RAW_TEXT=50000
LOG_LEVEL=INFO
AI_SERVICE_SHARED_SECRET=CHANGE_ME_INTERNAL_SHARED_SECRET
RETRIEVAL_AGGREGATE_TIMEOUT_SECONDS=20
# Enables explicit grounded/text fallbacks; embedding outages never synthesize vectors.
AI_DEGRADED_ALLOWED=true
AI_RUNTIME_MODE=cloud
AI_CLOUD_FALLBACK_PROVIDER=openrouter
AI_CLOUD_FALLBACK_ENABLED=true
AI_CLOUD_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
AI_CLOUD_FALLBACK_MODEL=openrouter/auto
AI_CLOUD_FALLBACK_API_KEY=CHANGE_ME_OPENROUTER_KEY
OPENROUTER_VISION_MODEL=
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-2-preview
OPENROUTER_HTTP_REFERER=https://nexora-lms.com
OPENROUTER_X_TITLE=Nexora LMS
AI_TUTOR_MAX_INFLIGHT=8
AI_TUTOR_REJECT_STATUS=429
AI_TUTOR_RETRY_AFTER_S=5
AI_TEACHER_BG_MAX_CONCURRENCY=2
AI_EXTRACTION_BG_MAX_CONCURRENCY=1
