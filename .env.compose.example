# Docker compose runtime environment (copy to .env.compose and customize).
# Compose is configured to fail fast if these required variables are missing.

# PostgreSQL bootstrap password (used only when the postgres_data volume is first initialized).
# Replace every CHANGE_ME value before starting Compose.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6379

# Keep both URLs aligned with POSTGRES_PASSWORD.
# IMPORTANT: URL-encode special characters in passwords (e.g. @ becomes %40).
BACKEND_DATABASE_URL=postgresql://postgres:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/capstone
AI_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/capstone

# Required backend secrets
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET_01
JWT_REFRESH_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_SECRET_02
OTP_PEPPER=CHANGE_ME_AT_LEAST_32_CHARS_LONG_PEPPER_03
AI_SERVICE_SHARED_SECRET=CHANGE_ME_INTERNAL_SHARED_SECRET

# Required when starting `--profile observability`; no default credentials exist.
GRAFANA_ADMIN_USER=CHANGE_ME_GRAFANA_ADMIN_USER
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
# Enable both values only after configuring the GF_SMTP_* variables below.
GRAFANA_ALERTING_ENABLED=false
# Alert receiver used by Grafana provisioning. Replace for real notifications.
GRAFANA_ALERT_EMAIL=ops@example.invalid
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=alerts@nexora.local

# Optional compose overrides
GRAFANA_PORT=3002
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_PORT=3200
RUN_DB_MIGRATIONS=true
RUN_DB_SEED=false
FRONTEND_PORT=3001
AI_SERVICE_PORT=8000
# Set these only when starting with --profile observability.
OTEL_EXPORTER_OTLP_ENDPOINT=
LOKI_HOST=
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
